# --- Per-video project content (local only) ---
project.json

# Script — empty Script.txt tracked as template; other files local
01-script/*
!01-script/Script.txt

# Narration audio
02-audio/*
!02-audio/.gitkeep

# Transcript — empty transcript.txt tracked as template; other files local
03-transcript/*
!03-transcript/transcript.txt

# Generated manifest / cut plan
04-manifest/*
!04-manifest/.gitkeep

# Generated frame images
05-images/*
!05-images/.gitkeep
!05-images/style-explore/
05-images/style-explore/*
!05-images/style-explore/explore_*.png
!05-images/style-explore/manifest.json

# Rendered video
06-output/*
!06-output/.gitkeep

# --- YouTube upload (secrets + generated assets) ---
07-upload/*
!07-upload/.gitkeep
!07-upload/requirements-youtube.txt
07-upload/client_secret*.json
07-upload/youtube_token.json
07-upload/upload_metadata.json
07-upload/thumbnail.png
07-upload.zip

# --- Studio runtime (tracker) ---
tracker/studio.pid
tracker/studio.log
tracker/runner.log
tracker/port.txt
tracker/status.json
tracker/usage.json
tracker/recent.json
tracker/logs/
tracker/credit_calibration.log
tracker/style_explore_run.log

# --- Python / OS ---
.env
token.json
*.pyc
__pycache__/
.DS_Store
.cache/
.venv/
