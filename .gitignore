# --- Per-video project content (local only) ---
project.json
queue.json

# Script, audio, transcript — project-specific, never committed
01-script/*
02-audio/*
!02-audio/.gitkeep
03-transcript/*

# Generated manifest / cut plan
04-manifest/*
!04-manifest/.gitkeep

# Generated frame images (production only — per video)
05-images/*
!05-images/.gitkeep

# Style sample previews (committed — never deleted by cleanup)
assets/style-samples/*
!assets/style-samples/explore_*.png
!assets/style-samples/variants.json
!assets/style-samples/manifest.json
!assets/style-samples/README.md

# Rendered video
06-output/*
!06-output/.gitkeep

# --- YouTube upload (secrets + generated assets) ---
07-upload/*
!07-upload/.gitkeep
!07-upload/requirements-youtube.txt
07-upload/client_secret*.json
07-upload/youtube_token.json
07-upload/upload_metadata.json
07-upload/thumbnail.png
07-upload.zip

# --- Multi-project queue ---
projects/*
!projects/.gitkeep

# --- Studio runtime (tracker) ---
tracker/studio.pid
tracker/studio.log
tracker/runner.log
tracker/port.txt
tracker/status.json
tracker/usage.json
tracker/recent.json
tracker/logs/
tracker/credit_calibration.log
tracker/style_explore_run.log
tracker/style-explore-run/
tracker/overnight.log
tracker/overnight.pid
tracker/queue.log
tracker/queue.pid
tracker/bulk_prompt.txt
tracker/thumbnail_options.json
tracker/supabase_config.json
tracker/video_preview.mp4

# --- Secrets ---
secrets.json

# --- Python / OS ---
.env
token.json
*.pyc
__pycache__/
.DS_Store
.cache/
.venv/
.venv-youtube/
exports/
